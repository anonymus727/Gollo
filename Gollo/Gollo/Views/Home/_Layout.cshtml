<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Gollo Costa Rica</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <!-- Google Fonts (Roboto) -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet" />

    <!-- Tus estilos personalizados -->
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f5f5f5;
        }
        /* Estilos adicionales si quieres */
        header {
            background-color: #0066ff; /* Azul Gollo */
        }

        footer {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <!-- ======================
         ENCABEZADO GLOBAL (Layout)
         ====================== -->
    <header class="text-white py-3 shadow-sm">
        <div class="container d-flex align-items-center">
            <!-- Logo: debe existir en wwwroot/images/logo.png -->
            <img src="~/images/logo.png" alt="Logo Gollo" style="height:60px; margin-right:15px;" />
            <h2 class="mb-0">Gollo Los Ángeles</h2>
        </div>
    </header>

    <!-- ======================
         Cuerpo de cada vista
         ====================== -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <!-- ======================
         PIE DE PÁGINA GLOBAL
         ====================== -->
    <footer class="text-center py-3 mt-5 border-top">
        <div class="container">
            <small class="d-block mb-2">© @DateTime.Now.Year Gollo Costa Rica. Todos los derechos reservados.</small>
            <a href="https://www.facebook.com/GolloCR" target="_blank" class="me-3 text-decoration-none">
                <i class="bi bi-facebook"></i> Facebook
            </a>
            <a href="https://www.instagram.com/gollo_cr" target="_blank" class="me-3 text-decoration-none">
                <i class="bi bi-instagram"></i> Instagram
            </a>
            <a href="mailto:info@gollo.com" class="text-decoration-none">
                <i class="bi bi-envelope"></i> Correo
            </a>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle (Popper + Bootstrap) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
